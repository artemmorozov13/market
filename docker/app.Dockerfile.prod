# Этап сборки
FROM node:20-alpine as builder
WORKDIR /app

# 1. Копируем только package.json (для лучшего кэширования)
COPY apps/app/package*.json ./
RUN npm ci  # Используем ci вместо install для production

# 2. Копируем shared модули и исходный код
COPY shared ./shared
COPY apps/app/. .

# 3. Сборка приложения
RUN npm run build

# Финальный образ (используем nginx для статики)
FROM nginx:alpine

# Копируем собранные файлы из builder-этапа
COPY --from=builder /app/dist /usr/share/nginx/html

# Копируем конфиг nginx (убедитесь, что файл существует)
COPY apps/app/nginx.conf /etc/nginx/conf.d/default.conf

# Проверка наличия файлов (опционально)
RUN ls -la /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]