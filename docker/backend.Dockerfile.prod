# Stage 1: Builder
FROM node:20-alpine as builder
WORKDIR /usr/src/app

# 1. Установка Nest CLI
RUN npm install -g @nestjs/cli

# 2. Копируем только package.json сначала для кэширования
COPY apps/backend/package*.json ./apps/backend/
COPY shared/package.json ./shared/

# 3. Устанавливаем зависимости
WORKDIR /usr/src/app/apps/backend
RUN npm install

# 4. Копируем ВСЕ файлы
WORKDIR /usr/src/app
COPY . .

# 5. Собираем проект
WORKDIR /usr/src/app/apps/backend
RUN npm run build

# Stage 2: Production
FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production

# 1. Копируем собранный проект
COPY --from=builder /usr/src/app/apps/backend/dist ./dist

# 2. Копируем только production зависимости
COPY --from=builder /usr/src/app/apps/backend/package*.json ./
RUN npm install --production

# 3. Копируем shared модули
COPY --from=builder /usr/src/app/shared ./shared

EXPOSE 9000
CMD ["node", "dist/main.js"]