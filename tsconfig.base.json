{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["./shared/src/*"],
      "@admin/*": ["./apps/admin/src/*"],
      "@app/*": ["./apps/app/src/*"],
      "@backend/*": ["./apps/backend/src/*"]
    }
  },
  "exclude": ["node_modules"]
}